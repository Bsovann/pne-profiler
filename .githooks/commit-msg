#!/bin/sh
# Rejects commit messages that don't start with a Jira key like "SCRUM-11: ...",
# so every commit links to its ticket. Enable with:
#   git config core.hooksPath .githooks

msg_file="$1"

# The subject is the first line that isn't blank or a git comment.
subject=$(grep -v -e '^#' -e '^[[:space:]]*$' "$msg_file" | head -n 1)

# Let messages generated by git through: merges, reverts, and autosquash commits.
case "$subject" in
    "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

if printf '%s\n' "$subject" | grep -Eq '^SCRUM-[0-9]+: '; then
    exit 0
fi

cat >&2 <<EOF
commit-msg: the message must start with the Jira key, e.g.

    SCRUM-11: add CLI integration tests

Got: "$subject"
Use the hyphenated form (SCRUM-11, not SCRUM11) followed by ": ".
EOF
exit 1
